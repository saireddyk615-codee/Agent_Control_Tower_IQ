# ── Foundry IQ mode ──────────────────────────────────────────────────────────
# Set to "azure" to enable real Azure AI Search policy grounding.
# Set to "mock" (default) to use local policy fallback — no credentials required.
FOUNDRY_IQ_MODE=mock

# ── Azure AI Search (required for azure mode) ─────────────────────────────────
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX=agent-security-policies
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_KNOWLEDGE_BASE=agent-control-tower-security-kb

# ── Legacy / alternative Azure AI Search keys (kept for compatibility) ─────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=
AZURE_SEARCH_API_VERSION=2025-11-01-preview

# ── Optional Foundry metadata ─────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
FOUNDRY_KNOWLEDGE_BASE_ID=
